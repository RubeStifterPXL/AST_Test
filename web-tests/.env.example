# Kopieer naar web-tests/.env (staat in .gitignore) en vul in. Omgevingsvariabelen gaan voor.
QA_PASSWORD=
BASE_URL=https://qacademyb.duckdns.org
KEYCLOAK_URL=https://qacademy-auth.duckdns.org
# chromium | firefox | webkit
BROWSER=chromium
# false = browser zichtbaar, handig bij debuggen; SLOW_MO_MS vertraagt elke actie
HEADLESS=true
SLOW_MO_MS=0
# true = ook traces bewaren van geslaagde tests (target/artifacts/traces)
TRACE_ALWAYS=false
